# Polymarket Crypto 5-Min Bot v5.0.0
# Copy to .env or use the web dashboard (Start.bat / start.sh).

# Optional: premium after purchase (free is default)
# BOT_PLAN=premium

# --- Polymarket credentials (required for live) ---
POLYMARKET_FUNDER=
POLYMARKET_PK=
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_PASSPHRASE=

# --- Core trading ---
USE_LIGHTWEIGHT_PREDICTOR=1
MARKET_BUY_USD=10.0
MARTINGALE_BASE_USD=10
MARTINGALE_MAX_STAKE_USD=16

# --- Predictor (min score skips weak signals) ---
PREDICTOR_MIN_SCORE=0.50
PREDICTOR_POLL_SECONDS=5
PREDICTOR_USE_5M_CANDLE=1
PREDICTOR_USE_CLOB_BOOK=1
PREDICTOR_REQUIRE_TREND_ALIGN=0
PREDICTOR_REQUIRE_CANDLE_ALIGN=0
PREDICTOR_RESOLUTION_MODE=polymarket

# --- Timing ---
SUBMIT_SECONDS_BEFORE_BOUNDARY=60
PREDICTOR_EVAL_POST_END_SEC=90
PREDICTOR_FULL_SLUGS_TO_SKIP_AFTER_SCORE=1

# --- Markets (5m up/down: btc, eth, sol, xrp, doge, hype, bnb) ---
# Single asset:
TRADING_ASSET=btc
# Multiple assets (comma-separated; overrides TRADING_ASSET):
# TRADING_ASSETS=btc,eth,sol
BTC_MARKET_INTERVAL_SECONDS=300
# Legacy (optional; inferred from TRADING_ASSET if unset):
# BTC_UPDOWN_SLUG_PREFIX=btc-updown-5m
BTC_SLUG_HOURS_AHEAD=6.0
BTC_SLUG_MAX=96
# Optional override for primary asset spot feed (default matches TRADING_ASSET):
# COINBASE_PRODUCT_ID=BTC-USD

# --- Logging & ops ---
BOT_VERBOSE=0
ORDER_LOG_ONLY=1
ORDER_LOG_FILE=logs/orders.log
ORDER_SUMMARY_LOG_FILE=log.txt
POLYMARKET_AUTO_REDEEM=1

# --- Redis (optional — runtime sim/live toggle) ---
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_DB=2
